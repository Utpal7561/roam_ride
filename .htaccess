# Root .htaccess for Rome & Ride
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Block sensitive files
    RewriteRule ^\.env.*$ - [F,L]
    RewriteRule ^storage/.*$ - [F,L]
    RewriteRule ^database/.*$ - [F,L]
    RewriteRule ^app/.*$ - [F,L]
    RewriteRule ^config/.*$ - [F,L]
    RewriteRule ^\.git.*$ - [F,L]
    RewriteRule \.(env|ini|log|sql|bak|backup|md)$ - [F,L]

    # Rewrite all traffic to public/
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

<FilesMatch "\.(env|ini|log|sql|bak|backup|sh|bat)$">
    Require all denied
</FilesMatch>

Options -Indexes
