APP_NAME="Rome & Ride"
APP_TAGLINE="PICK. RIDE. EXPLORE."
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/roam_ride

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rome_and_ride
DB_USERNAME=root
DB_PASSWORD=

JWT_SECRET=your_random_64_character_secret_key_here
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=604800

RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE=database

UPLOAD_MAX_SIZE=5242880

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=support@romeandride.com
SMTP_FROM_NAME="Rome & Ride"

PAYMENT_GATEWAY=simulated
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
